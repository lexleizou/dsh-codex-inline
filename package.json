{
  "name": "dsh-inline-references",
  "version": "1.0.0",
  "type": "module",
  "description": "Skill display names and website icons in the DeepSeek Harness message composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/taobao.png",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexleizou/dsh-inline-references.git"
  },
  "homepage": "https://github.com/lexleizou/dsh-inline-references#readme",
  "bugs": {
    "url": "https://github.com/lexleizou/dsh-inline-references/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "favicon",
    "skills"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  }
}
